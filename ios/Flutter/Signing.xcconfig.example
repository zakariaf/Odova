// The shape of `ios/Flutter/Signing.xcconfig`, with no values in it.
//
// The real file is gitignored and is written by the release workflow from
// secrets. Copy this, fill in the three values, and `tools/release.sh` can
// export locally. `tools/check_release_hygiene.sh` refuses the credentials that
// would otherwise end up beside it.
DEVELOPMENT_TEAM=TEAM_ID
PROVISIONING_PROFILE_SPECIFIER=PROFILE_NAME
CODE_SIGN_STYLE=Manual
