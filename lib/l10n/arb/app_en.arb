        "example": "14",
        "description": "The count as the app already formatted and shaped it. A SECOND placeholder for the same number, on purpose: the int selects the CLDR category and an int interpolated by gen-l10n renders in Latin digits, which would put \"412\" inside a Persian sentence while every other number on screen is shaped."
      },
      "costs": {
        "type": "int",
        "example": "22"
      },
      "costsText": {
        "type": "String",
        "example": "22",
        "description": "The count as the app already formatted and shaped it. A SECOND placeholder for the same number, on purpose: the int selects the CLDR category and an int interpolated by gen-l10n renders in Latin digits, which would put \"412\" inside a Persian sentence while every other number on screen is shaped."
      },
      "trips": {
        "type": "int",
        "example": "8"
      },
      "tripsText": {
        "type": "String",
        "example": "8",
        "description": "The count as the app already formatted and shaped it. A SECOND placeholder for the same number, on purpose: the int selects the CLDR category and an int interpolated by gen-l10n renders in Latin digits, which would put \"412\" inside a Persian sentence while every other number on screen is shaped."
      },
      "reminders": {
        "type": "int",
        "example": "16"
      },
      "remindersText": {
        "type": "String",
        "example": "16",
        "description": "The count as the app already formatted and shaped it. A SECOND placeholder for the same number, on purpose: the int selects the CLDR category and an int interpolated by gen-l10n renders in Latin digits, which would put \"412\" inside a Persian sentence while every other number on screen is shaped."
      }
