  "snoozeAtOdometer": "at {odometer}",
  "@snoozeAtOdometer": {
    "description": "The resolved reading on the distance option. {odometer} is the entered cumulative reading plus 500 km, already formatted — never a projection, which would move every time the estimate did.",
    "placeholders": {
