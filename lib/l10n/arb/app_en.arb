  "routeNotFoundTitle": "Not found",
  "@routeNotFoundTitle": {
    "description": "App bar title on the 404 screen. SPEC.md §7: an unknown link lands somewhere designed rather than on a red error box."
  },
  "routeNotFoundBody": "That link doesn't lead anywhere.",
  "@routeNotFoundBody": {
    "description": "The one sentence on the 404 screen. Deliberately does not name the app or the link — a dead end is worse than a wrong turn, and the sentence exists only to hand the user the button below it."
  },
  "routeNotFoundGoHome": "Go to Home",
  "@routeNotFoundGoHome": {
    "description": "The single action on the 404 screen. Home is the one screen that always exists and always has something to say."
  },
  "tabHome": "Home",
  "@tabHome": {
    "description": "Tab 1. SPEC.md §7: the tab labels are always visible under their icons — there is no icon-only mode to fall into. German and Sorani both run long here and wrap to two lines rather than truncating."
  },
  "historyMonthEntryCount": "{n, plural, one{{nText} entry} other{{nText} entries}}",
  "@historyMonthEntryCount": {
    "description": "§11's month header count — \"9 entries · €412.80\". `nText` is a SECOND placeholder for the same number because {n} selects the CLDR category and must be an int, and an int interpolated by gen-l10n renders in Latin digits — which would put \"9\" in Latin inside a Persian header while every other number on the screen is shaped. SPEC.md §5: one numbering system is active app-wide.",
    "placeholders": {
      "n": {
        "type": "int",
        "example": "9"
      },
      "nText": {
        "type": "String",
        "example": "9"
      }
    }
  },
  "bandFillUpFirstFill": "First fill-up — your first consumption figure arrives at the next full tank.",
  "@bandFillUpFirstFill": {
    "description": "§11 verbatim. One of three sentences a fill-up band shows INSTEAD of a figure; a row gets exactly one."
  },
  "bandFillUpChainBroken": "No figure: the tank before this wasn't logged.",
  "@bandFillUpChainBroken": {
    "description": "§11 verbatim. Shown when the tank before this one was not logged."
  },
  "bandFillUpPartial": "No figure: partial fill.",
  "@bandFillUpPartial": {
    "description": "§11 verbatim. Shown for a part fill, which produces no figure on its own."
  },
  "bandFillUpSegment": "{consumption} over {distance} since {date}",
  "@bandFillUpSegment": {
    "description": "§11's fill-up band: the segment figure with the distance and dates it covers. Every part arrives already formatted and isolate-wrapped — the numbers are shaped against the FORMATS tag and the date through the locale's calendar.",
    "placeholders": {
      "consumption": {
        "type": "String"
      },
      "distance": {
        "type": "String"
      },
      "date": {
        "type": "String"
      }
    }
  },
  "bandExpenseSpread": "{total} over {months} = {perMonth} a month",
  "@bandExpenseSpread": {
    "description": "§11 verbatim in shape: \"€ 480.00 over 12 months = € 40.00 a month.\" The month count is a pre-formatted, pluralised String rather than an int, so a Persian band does not render a Latin 12.",
    "placeholders": {
      "total": {
        "type": "String"
      },
      "months": {
        "type": "String"
      },
      "perMonth": {
        "type": "String"
      }
    }
  },
  "bandOdometerRate": "{distance} in {days} — {rate} a day",
  "@bandOdometerRate": {
    "description": "§11 verbatim in shape: \"1,240 km in 31 days — 40 km a day.\" Shown only where two readings are on different days; the same day implies no rate at all.",
    "placeholders": {
      "distance": {
        "type": "String"
      },
      "days": {
        "type": "String"
      },
      "rate": {
        "type": "String"
      }
    }
  },
  "bandDeleteFillUp": "Delete this fill-up",
  "@bandDeleteFillUp": {
    "description": "The destructive row at the BOTTOM of log.fillup in edit mode. §11: Delete \"sits at the bottom of the form, destructive-styled, never in the app bar where Save is.\""
  },
  "recomputeFiguresRecalculated": "{n, plural, one{{nText} later fuel figure recalculated} other{{nText} later fuel figures recalculated}}",
  "@recomputeFiguresRecalculated": {
    "description": "§11's snackbar second half, verbatim in shape: \"14 later fuel figures recalculated\". The count comes from the recompute DIFF and never from what was edited — a message that counted the rows the user touched would say this for an edit that changed a vendor name. `nText` is a second placeholder for the same number because {n} selects the CLDR category and must be an int, and gen-l10n renders a bare int in Latin digits.",
    "placeholders": {
      "n": {
        "type": "int",
        "example": "14"
      },
      "nText": {
        "type": "String",
        "example": "14"
      }
    }
  },
  "recomputeSaved": "Saved",
  "@recomputeSaved": {
    "description": "§11's last snackbar row: shown when NOTHING derived changed. Editing a vendor name must not claim to have recalculated anything."
  },
  "recomputeFillUpUpdated": "Fill-up updated",
  "@recomputeFillUpUpdated": {
    "description": "The first half of §11's fill-up snackbar. The second half — how many figures moved — is appended only when the diff says some did."
  },
  "recomputeServiceUpdated": "Service updated",
  "@recomputeServiceUpdated": {
    "description": "As recomputeFillUpUpdated, for a service record."
  },
  "recomputeExpenseUpdated": "Expense updated",
  "@recomputeExpenseUpdated": {
    "description": "§11's expense row, which has no second half: an expense participates in no consumption figure."
  },
  "recomputeOdometerUpdated": "Reading updated",
  "@recomputeOdometerUpdated": {
    "description": "As recomputeFillUpUpdated, for a standalone reading."
  },
  "historyReport": "Report",
  "@historyReport": {
    "description": "§11's app-bar action opening report.service. A NOUN, because it names a document rather than an act — the report is a thing handed to a buyer."
  },
  "historySearchHint": "Search",
  "@historySearchHint": {
    "description": "The search field's placeholder. One word — §11 makes search a mode inside history, not a screen with an explanation."
