  "confirmDeleteMismatch": "That doesn't match {subject}.",
  "@confirmDeleteMismatch": {
    "description": "Shown under the typed-confirmation field when what was typed does not match. SPEC.md §8 gives the wording: \"That doesn't match The Golf.\" Without it the user who mistypes reads the instruction again and is never told they got it wrong.",
    "placeholders": {
      "subject": {
        "type": "String",
        "example": "The Golf"
      }
    }
  },
  "confirmDeleteDelete": "Delete",
  "@confirmDeleteDelete": {
