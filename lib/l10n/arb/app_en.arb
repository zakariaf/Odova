  "commonCancel": "Cancel",
  "@commonCancel": {
    "description": "The way out of any dialog. ONE key, not one per dialog: it was the same word in all six locales twice over, which is two chances for a translator to make two dialogs in the same app disagree about \"Cancel\". Tap-out and system back both mean this, and SPEC.md §7 says no dialog is ever dismissed into a destructive outcome."
  },
  "commonContinue": "Continue",
  "@commonContinue": {
    "description": "Moves to the next step of first run. SPEC.md §8 gives the label in all six: Continue / Weiter / Continuer / ادامه / متابعة / بەردەوام بە. It is rendered in the language the user has just tapped, not the device's, so it wraps to two lines rather than shrinking — \"Weiter\" and \"بەردەوام بە\" are very different widths."
  },
  "commonRestoreBackup": "Restore a backup",
  "@commonRestoreBackup": {
    "description": "Opens the OS document picker on the way to settings.import. Offered on both first-run screens because the second-most-likely reason a stranger is on them is a new phone."
  },
  "settingsLanguageSystem": "System ({language})",
  "@settingsLanguageSystem": {
    "description": "The first row of the seven-row language list. The parenthesis names what `system` resolves to RIGHT NOW and updates live, so a de-DE device reads \"System (Deutsch)\". SPEC.md §5 Override.",
    "placeholders": {
      "language": {
        "type": "String",
        "example": "Deutsch"
      }
    }
  },
  "settingsLanguageNotTranslated": "Odova isn’t translated into your device’s language yet. Numbers, dates, units and money will still follow your region.",
  "@settingsLanguageNotTranslated": {
    "description": "Sits under the language list when the device language is none of the six. SPEC.md §5 and §8. It deliberately takes NO placeholder — EPIC-09 F-9.8: nothing in the dependency set supplies a language's own name for an arbitrary tag, and a hand-written endonym table would put a misspelling of somebody's own language, in their own script, on the app's first screen."
  },
  "firstRunLanguageTagline": "Pick the one you read best.",
  "@firstRunLanguageTagline": {
    "description": "One line under the wordmark on firstrun.language. It is in the artboard rather than in SPEC's prose, and CLAUDE.md §7 makes the reference the authority for what the screen says."
  },
  "firstRunRestorePrompt": "Moving from another phone?",
  "@firstRunRestorePrompt": {
    "description": "The caption between Continue and Restore a backup on firstrun.language. SPEC.md §8's wording wins over §14's — EPIC-09 F-9.3."
  },
  "firstRunVehicleTitle": "Your vehicle",
  "@firstRunVehicleTitle": {
    "description": "App bar title on `firstrun.vehicle`, the second and last screen of first run."
  },
  "firstRunVehicleSubtitle": "One vehicle and one number. That is the whole setup.",
  "@firstRunVehicleSubtitle": {
    "description": "App bar subtitle. It promises how short the setup is, which is the screen's whole job — SPEC.md §8: one vehicle and one odometer reading in under thirty seconds."
